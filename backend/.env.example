# Server Configuration
PORT=8000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database
MONGO_URI=mongodb://localhost:27017/cityzen

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# Aadhaar Authentication Settings
AADHAAR_PROVIDER=mock
